#!/bin/bash
# TrackerTestServer pre-installation script

set -e

case "$1" in
    install|upgrade)
        echo "Preparing to install TrackerTestServer..."
        
        # Check if system supports systemd
        if [ ! -x "/usr/bin/systemctl" ]; then
            echo "Warning: systemctl not found. Service management will be skipped."
        fi
        
        # Check if required ports are in use
        if command -v netstat > /dev/null 2>&1; then
            if netstat -ln | grep -q ":7900 "; then
                echo "Warning: Port 7900 is already in use. TrackerTestServer may not start properly."
            fi
            if netstat -ln | grep -q ":8900 "; then
                echo "Warning: Port 8900 is already in use. Heartbeat may not work properly."
            fi
        fi
        
        # Check if old version service is running
        if [ -x "/usr/bin/systemctl" ] && systemctl is-active --quiet TrackerTestServer.service 2>/dev/null; then
            echo "Stopping existing TrackerTestServer service..."
            systemctl stop TrackerTestServer.service || true
        fi
        
        # Create target directory
        if [ ! -d "/opt/TrackerTestServer" ]; then
            mkdir -p /opt/TrackerTestServer
            echo "Created installation directory: /opt/TrackerTestServer"
        fi
        ;;
        
    abort-upgrade)
        # Handle abort-upgrade case
        ;;
        
    *)
        echo "preinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0 