#!/bin/bash
# TrackerTestServer pre-removal script

set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Stop and disable TrackerTestServer service
        if [ -x "/usr/bin/systemctl" ]; then
            echo "Stopping TrackerTestServer service..."
            systemctl stop TrackerTestServer.service || true
            echo "Disabling TrackerTestServer service..."
            systemctl disable TrackerTestServer.service || true
            systemctl --system daemon-reload || true
        fi
        ;;
    
    failed-upgrade)
        # Handle failed-upgrade case
        ;;
        
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0