#!/bin/bash
# TrackerTestServer post-removal script

set -e

case "$1" in
    remove)
        # Cleanup work after removal
        echo "Cleaning up TrackerTestServer..."
        
        # Reload systemd configuration
        if [ -x "/usr/bin/systemctl" ]; then
            systemctl --system daemon-reload || true
        fi
        
        # Clean up log files (optional, decide based on requirements)
        # if [ -d "/var/log/TrackerTestServer" ]; then
        #     echo "Removing log directory..."
        #     rm -rf /var/log/TrackerTestServer
        # fi
        ;;
        
    purge)
        # Completely remove configuration and data
        echo "Purging TrackerTestServer configuration and data..."
        
        # Remove log directory
        if [ -d "/var/log/TrackerTestServer" ]; then
            echo "Removing log directory..."
            rm -rf /var/log/TrackerTestServer
        fi
        
        # Remove any remaining configuration files
        if [ -f "/etc/systemd/system/TrackerTestServer.service" ]; then
            echo "Removing service file..."
            rm -f /etc/systemd/system/TrackerTestServer.service
        fi
        
        # Reload systemd configuration
        if [ -x "/usr/bin/systemctl" ]; then
            systemctl --system daemon-reload || true
        fi
        ;;
        
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Handle upgrade-related cases
        ;;
        
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0 