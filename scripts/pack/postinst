#!/bin/bash
# TrackerTestServer post-installation script

set -e

case "$1" in
    configure)
        # Enable and start TrackerTestServer service
        if [ -x "/usr/bin/systemctl" ]; then
            echo "Configuring TrackerTestServer service..."
            systemctl --system daemon-reload || true
            echo "Enabling TrackerTestServer service for auto-start..."
            systemctl enable TrackerTestServer.service || true
            echo "Starting TrackerTestServer service..."
            systemctl start TrackerTestServer.service || true
            
            # Check service status
            sleep 2
            if systemctl is-active --quiet TrackerTestServer.service; then
                echo "TrackerTestServer service started successfully!"
            else
                echo "Warning: TrackerTestServer service may have failed to start"
                echo "Check status with: systemctl status TrackerTestServer.service"
            fi
        else
            echo "systemctl not found, skipping service configuration"
        fi
        
        # Create necessary log directory and set permissions
        if [ ! -d "/var/log/TrackerTestServer" ]; then
            mkdir -p /var/log/TrackerTestServer
            chmod 755 /var/log/TrackerTestServer
            echo "Created log directory: /var/log/TrackerTestServer"
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        # Handle installation abort cases
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
